{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "개발 환경 전체 확인",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Task", "check"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "테스트 실행",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Task", "test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "변경 시 테스트 자동 실행",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Task", "watch"],
      "problemMatcher": []
    },
    {
      "label": "오프라인 데모 실행",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Task", "demo"],
      "problemMatcher": []
    }
  ]
}
