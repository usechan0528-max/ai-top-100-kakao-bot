      [
        {
          "text": "적립금 환불",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "현금 환급이 아니므로 증빙 정정 없음",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "부분환불 후 재차 부분환불",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "잔액 기준으로 다시 수정 발행",
          "rowspan": 1,
          "colspan": 1
        }
      ]
    ],
    [
      [
        {
          "text": "요구",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "판정",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "실제 결제자와 다른 사업자 명의",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "거절",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "가공 사업자 명의",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "거절",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "개인 결제분을 사업자 명의 로",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "거절 (실제 공급받은 자가 아니다)",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "실결제액보다 많은 금액 기재",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "거절",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "실제와 다른 품목·품명 기재",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "거절",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "발행 기한 지난 건의 소급 발행",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "거절 — 국세청 자율 발급 안내",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "결제가 취소된 거래 의 증빙을 그대로 유지해 달라는 요구",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "거절 — 거래가 취소되었으므로 해당 증빙을 유지할 수 없다 (§5)",
          "rowspan": 1,
          "colspan": 1
        }
      ]
    ]
  ]
}