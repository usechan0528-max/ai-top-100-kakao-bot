  "tables": [
    [
      [
        {
          "text": "언제",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "무엇을",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "수단",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "구독 개시 시 (계약 내용)",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "주기·결제일·컷오프의 계산 방식",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "정기배송 신청 화면 및 신청 완료 안내",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "각 회차 컷오프 도래 2영업일 전까지",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "그 회차의 결제 예정일과 컷오프 일시(날짜·시각)",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "구독·주문 내역 화면 표시를 기본으로 하고, 고객이 등록한 알림 수단이 있으면 함께 발송",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "컷오프 경과 후",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "그 회차가 확정되었다는 사실과 다음 회차의 컷오프 일시",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "같음",
          "rowspan": 1,
          "colspan": 1
        }
      ]
    ],
    [
      [
        {
          "text": "대안",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "조건",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "수령일 조정",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "집하 전 (「택배사 계약서」 제3조)",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "배송지 변경",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "집하 전 (「택배사 계약서」 제3조)",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "이번 회차 취소·환불",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "출고 준비 전에 한하여 가능",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "다음 회차 스킵 예약",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "상시",
          "rowspan": 1,
          "colspan": 1
        }
      ]
    ],
    [
      [
        {
          "text": "요청",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "컷오프 전",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "컷오프 이후",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "스킵",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "이번 회차 미결제·미발송",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "다음 회차부터. 이번 회차는 제6조② 대안 안내",
          "rowspan": 1,
          "colspan": 1
        }
      ],
      [
        {
          "text": "해지",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "이번 회차부터 종료, 남은 회차 전액환불",
          "rowspan": 1,
          "colspan": 1
        },
        {
          "text": "다음 회차부터 종료. 이번 회차는 제6조② 대안 안내",
          "rowspan": 1,
          "colspan": 1
        }
